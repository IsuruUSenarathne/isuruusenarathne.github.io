---
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<section class="section" id={id} aria-labelledby={`${id}-title`}>
  <h2 class="section-title" id={`${id}-title`} data-reveal>{title}</h2>
  <slot />
</section>

<style>
  .section {
    padding: 2.5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .section:last-of-type {
    border-bottom: none;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.5rem;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .section-title::before {
    content: '';
    width: 4px;
    height: 1.1em;
    border-radius: 2px;
    background: var(--accent);
    transform-origin: bottom;
  }

  .section-title.is-visible::before {
    animation: grow 0.5s var(--ease-out) 0.25s backwards;
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
