---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { iconForLabel } from '../lib/icons';
import { withBase } from '../lib/url';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  nav: { id: string; label: string }[];
}

const { profile, nav } = Astro.props;

function getInitials(name: string): string {
  const words = name.split(' ').filter(Boolean);
  const first = words[0]?.[0] ?? '';
  const last = words.length > 1 ? words[words.length - 1][0] : '';
  return (first + last).toUpperCase();
}
---

<aside class="sidebar card enter">
  <div class="sidebar-top">
    {
      profile.photo ? (
        <img class="avatar" src={withBase(profile.photo)} alt={profile.name} width="112" height="112" />
      ) : (
        <div class="avatar avatar-fallback" aria-hidden="true">
          {getInitials(profile.name)}
        </div>
      )
    }
    <ThemeToggle />
  </div>

  <h1 class="name enter" style="--delay: 150ms">{profile.name}</h1>
  <p class="role enter" style="--delay: 220ms">{profile.role}</p>

  <a class="btn btn-primary download enter" style="--delay: 290ms" href={withBase(profile.cv)} download>
    <span class="download-icon"><Icon name="download" /></span> Download CV
  </a>

  <ul class="contact-list enter" style="--delay: 360ms">
    <li><Icon name="location" /> {profile.location}</li>
    <li><Icon name="mail" /> <a href={`mailto:${profile.email}`}>{profile.email}</a></li>
    {
      profile.phone && (
        <li>
          <Icon name="phone" /> <a href={`tel:${profile.phone.replace(/\s/g, '')}`}>{profile.phone}</a>
        </li>
      )
    }
    {
      profile.links.map((link) => (
        <li>
          <Icon name={iconForLabel(link.label)} />
          <a href={link.url} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <nav class="nav enter" style="--delay: 430ms" aria-label="Sections">
    {nav.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
  </nav>
</aside>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.sidebar .nav a')];

  // Marks the link of the section crossing the middle of the viewport as current.
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );

  links.forEach((link) => {
    const section = document.querySelector(link.hash);
    if (section) observer.observe(section);
  });
</script>

<style>
  .sidebar {
    position: sticky;
    top: 2rem;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    padding: 1.75rem;
  }

  .sidebar-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    border: 3px solid var(--accent-soft);
    object-fit: cover;
    animation: pop 0.7s var(--ease-out) 80ms backwards;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s ease;
  }

  .avatar:hover {
    transform: scale(1.04) rotate(-2deg);
    box-shadow: 0 0 0 5px var(--accent-soft), var(--shadow-hover);
  }

  .avatar-fallback {
    display: grid;
    place-items: center;
    background: var(--accent);
    color: var(--accent-text);
    font-size: 2rem;
    font-weight: 600;
  }

  .name {
    margin: 1.25rem 0 0.2rem;
    font-size: 1.6rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .role {
    margin: 0;
    color: var(--accent);
    font-weight: 500;
  }

  .download {
    width: 100%;
    margin: 1.25rem 0;
  }

  .download-icon {
    display: flex;
  }

  .download:hover .download-icon {
    animation: nudge 0.6s ease;
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }

  .contact-list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
    font-size: 0.88rem;
  }

  .contact-list li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-muted);
    overflow-wrap: anywhere;
    transition: transform 0.2s var(--ease-out), color 0.2s ease;
  }

  .contact-list li:hover {
    color: var(--text);
    transform: translateX(3px);
  }

  .contact-list a {
    color: var(--text);
  }

  .nav {
    display: grid;
    gap: 0.15rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .nav a {
    position: relative;
    padding: 0.35rem 0.6rem 0.35rem 0.9rem;
    border-radius: 8px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 500;
    transition: background-color 0.2s ease, color 0.2s ease, padding-left 0.25s var(--ease-out);
  }

  .nav a::before {
    content: '';
    position: absolute;
    top: 25%;
    bottom: 25%;
    left: 0.3rem;
    width: 3px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transition: transform 0.25s var(--ease-out);
  }

  .nav a:hover,
  .nav a[aria-current] {
    background: var(--surface-muted);
    color: var(--text);
    text-decoration: none;
  }

  .nav a[aria-current] {
    padding-left: 1.2rem;
    font-weight: 600;
  }

  .nav a[aria-current]::before {
    transform: scaleY(1);
  }

  @media (max-width: 900px) {
    .sidebar {
      position: static;
      max-height: none;
    }

    .nav {
      display: none;
    }
  }
</style>
